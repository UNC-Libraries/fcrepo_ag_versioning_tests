# Fedora Repository Configuration
FCREPO_HOST=http://localhost:8086
FCREPO_BASE_PATH=/fcrepo/rest

# Docker Compose test storage paths. Set FCREPO_OCFL_PATH to fcrepo7/ocfl
# when testing Fedora 7. Fedora 5 uses ModeShape storage rather than OCFL.
FCREPO_EXTERNAL_CONTENT_PATH=./test_bins
FCREPO_EXTERNAL_CONTENT_URI=file:///external/
FCREPO_OCFL_PATH=./docker-data/fcrepo6/ocfl

# Fedora 6 and 7 startup option. Restart the target service after changing it.
FCREPO_AUTOVERSIONING_ENABLED=false

# Authentication for the standard Fedora Docker images
FCREPO_USERNAME=fedoraAdmin
FCREPO_PASSWORD=fedoraAdmin

# Test Configuration
TEST_CONFIG_NAME=default
# Number of users to simulate
LOCUST_USERS=10

# Spawn rate (users per second)
LOCUST_SPAWN_RATE=1

# Test duration (e.g., 10m, 1h)
LOCUST_RUN_TIME=5m

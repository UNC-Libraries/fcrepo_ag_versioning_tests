# Fedora Repository Configuration
FCREPO_HOST=http://localhost:8080
FCREPO_BASE_PATH=/fcrepo/rest

# Authentication (optional - uncomment and set if fcrepo requires authentication)
# FCREPO_USERNAME=admin
# FCREPO_PASSWORD=secret

# Test Configuration
# Number of users to simulate
LOCUST_USERS=10

# Spawn rate (users per second)
LOCUST_SPAWN_RATE=1

# Test duration (e.g., 10m, 1h)
LOCUST_RUN_TIME=5m
